# Rama de comparación: la raíz muestra index.html para elegir una versión.
# Cada carpeta (tecnologia/, combinado/, publicidad/) trae su propio .htaccess
# que sirve su carpeta public/ y bloquea config/, src/, database/ y storage/.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "(^|/)\.(?!well-known)" - [F]
  RewriteRule "^[^/]+/(config|src|database|storage)(/|$)" - [F]
  RewriteRule "\.(md|sql|log)$" - [F]
</IfModule>
